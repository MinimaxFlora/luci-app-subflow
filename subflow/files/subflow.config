
config subflow 'main'
	option enabled '1'
	option host '0.0.0.0'
	option port '8080'
	option data_dir '/etc/subflow'
	option log_level 'info'
	# User-Agent used when fetching remote subscriptions. Empty keeps the
	# built-in default.
	option fetch_user_agent ''
	# Allow fetching subscriptions from private network addresses. Off by
	# default to avoid SSRF through the subscription fetcher.
	option fetch_allow_private_hosts '0'
