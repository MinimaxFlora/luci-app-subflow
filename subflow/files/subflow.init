#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/subflow

start_service() {
	config_load subflow

	local enabled host port data_dir log_level user_agent allow_private
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get host main host '0.0.0.0'
	config_get port main port '8080'
	config_get data_dir main data_dir '/etc/subflow'
	config_get log_level main log_level 'info'
	config_get user_agent main fetch_user_agent ''
	config_get_bool allow_private main fetch_allow_private_hosts 0

	mkdir -p "$data_dir"

	procd_open_instance
	procd_set_param command "$PROG" \
		--host "$host" \
		--port "$port" \
		--data-dir "$data_dir" \
		--log-level "$log_level"
	[ -n "$user_agent" ] && procd_append_param command --fetch-user-agent "$user_agent"
	[ "$allow_private" -eq 1 ] && procd_append_param command --fetch-allow-private-hosts
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger subflow
}
